## App Settings
APP_NAME=InvoicePlane

CI_ENV=production
APP_ENV=production

## App Key
# The app key is used to encrypt data of your application and
# is automatically set in the setup. Do not change it manually!
APP_KEY=

# Debug and Development
# Having problems? Enable debug by changing the value to 'true' to enable advanced logging
ENABLE_DEBUG=false
APP_DEBUG=true
APP_EXTREME_LOGGING=false
DEBUGBAR_ENABLED=false

## App URL
# Set your URL without trailing slash here, e.g. http://your-domain.com
# If you use a subdomain, use http://subdomain.your-domain.com
# If you use a subfolder, use http://your-domain.com/subfolder
# No trailing slash!
APP_URL=http://ivpllrvl.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

## Logging Settings
# Configure logging channels and levels
LOG_CHANNEL=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

## InvoicePlane-Specific Settings
# The following settings are specific to InvoicePlane functionality

# Setup and Installation
# Set this setting to 'true' if you want to disable the setup for security purposes
DISABLE_SETUP=false
# Set to true after the initial setup (automatically set during installation)
SETUP_COMPLETED=false

# URL Rewriting
# To remove index.php from the URL, set this setting to 'true'.
# Please notice the additional instructions in the htaccess file!
REMOVE_INDEXPHP=false

# Invoice Settings
# Enable the deletion of invoices
ENABLE_INVOICE_DELETION=false
# Disable the read-only mode for invoices
DISABLE_READ_ONLY=false

# Security Settings
X_FRAME_OPTIONS=SAMEORIGIN
ENABLE_X_CONTENT_TYPE_OPTIONS=true

# Calculation Settings
# Default Global Amounts Calculation mode - Since 1.6.3
# This changes Taxes and discounts calculation mode
# true  : Taxes: Global Y, Item Y. Use classic calculation for Discounts & Taxes (Default)
# false : Taxes: Global N, Item Y. Use simple item tax calculation system
# Notes:
#   • When the client uses e-invoice: This is automatically overridden to false by default
#     to use "simple tax" calculation system for valid XML data for European models
#   • Dev Note: If you really need to override by true, just add 'legacy_calculation' => true
#     in $xml_settings. (See helpers/XMLconfigs/README.md)
#   • When using Facturx10Xml and Ubl24Xml XML templates based
#     Download here: https://github.com/InvoicePlane/InvoicePlane-e-invoices
LEGACY_CALCULATION=true

## Encryption Settings
# This key is automatically set after the first setup. Do not change it manually!
# For legacy support with InvoicePlane encryption
ENCRYPTION_KEY=
ENCRYPTION_CIPHER=AES-256

## Database Settings
# The following settings are used to connect to your database.
# They are set during the setup. Change them here if you move
# to another database or server if needed.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ivpllrvl
DB_USERNAME=invoiceplane
DB_PASSWORD=
DB_PREFIX=

## Session Settings
# Configure session behavior
# If you want to be logged out after closing your browser window, set SESSION_LIFETIME to 0 (ZERO).
# The number represents the amount of minutes after that IP will automatically log out users.
# For backwards compatibility: SESS_EXPIRATION in minutes (default 10 days = 864000 seconds / 60 = 14400 minutes)
SESS_EXPIRATION=14400
SESS_REGENERATE_DESTROY=false
SESS_MATCH_IP=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

## Driver Settings
# The following settings define which applications should be used
# for various application parts. Only change them if you know what
# you are doing.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=ivplv2

## Redis Settings
# Configure Redis for caching and queuing (optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

## Mail Settings
# Configure email delivery
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

## AWS Settings
# For S3 filesystem driver (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

## Pusher Settings
# For broadcasting (optional)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

## Vite Settings
# For frontend asset building
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sumex Customizations (Swiss Medical Invoices)
# Need one (or more) Name containing "sumex" in invoice groups
# Settings panel: true to Enable - Since v-1.6.3
SUMEX_SETTINGS=false
# Set the URL where to post the XML to get a generated PDF - Since v-1.5.0
# See https://github.com/InvoicePlane/InvoicePlane/pull/453
SUMEX_URL=
